From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pcDuino3B Armbian CI <noreply@github.com>
Date: Fri, 4 Sep 2026 23:03:06 +0800
Subject: [PATCH] sunxi: pcduino3b: enable onboard H27UBG8T2C NAND

Add a dedicated pcDuino3B U-Boot control DT instead of changing the
upstream pcDuino3 DT. Keep the registered pcDuino3 compatible base, but
expose the correct 3B model, verified RGMII-ID wiring, 3B-prefixed NAND
nodes and the fixed boot-FIT/rootfs layout. The board configuration loads
the self-contained FIT after removable-media targets and this patch adds
the exact NAND ID.

Fix the SPL ECC-strength probe to compare whole-page ECC and user-data
usage against the whole OOB area. The v2026.07 per-step/whole-page unit
mix-up otherwise caps this 8 KiB/640-byte-OOB device at 24-bit ECC, while
Linux writes U-Boot proper with the required 40-bit/1 KiB configuration.
---
 arch/arm/dts/Makefile                        |  1 +
 arch/arm/dts/sun7i-a20-pcduino3b.dts         | 87 ++++++++++++++++++++
 drivers/mtd/nand/raw/nand_ids.c              |  4 +
 drivers/mtd/nand/raw/sunxi_nand_spl.c        |  7 +-
 4 files changed, 95 insertions(+), 4 deletions(-)
 create mode 100644 arch/arm/dts/sun7i-a20-pcduino3b.dts

diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
index 2b65cd9..3758a39 100644
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -566,6 +566,7 @@ dtb-$(CONFIG_MACH_SUN7I) += \
 	sun7i-a20-orangepi.dtb \
 	sun7i-a20-orangepi-mini.dtb \
 	sun7i-a20-pcduino3.dtb \
+	sun7i-a20-pcduino3b.dtb \
 	sun7i-a20-pcduino3-nano.dtb \
 	sun7i-a20-primo73.dtb \
 	sun7i-a20-wexler-tab7200.dtb \
diff --git a/arch/arm/dts/sun7i-a20-pcduino3b.dts b/arch/arm/dts/sun7i-a20-pcduino3b.dts
new file mode 100644
index 0000000..1e72982
--- /dev/null
+++ b/arch/arm/dts/sun7i-a20-pcduino3b.dts
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/*
+ * LinkSprite pcDuino3B U-Boot control device tree.
+ *
+ * The board shares its A20/DRAM base with the upstream pcDuino3 target.
+ * Keep that file as the compatibility layer and describe only verified 3B
+ * differences here.
+ */
+
+/dts-v1/;
+#include "sun7i-a20-pcduino3.dts"
+
+/ {
+	model = "LinkSprite pcDuino3B";
+	compatible = "linksprite,pcduino3", "allwinner,sun7i-a20";
+};
+
+&gmac {
+	pinctrl-names = "default";
+	pinctrl-0 = <&gmac_rgmii_pins>;
+	phy-handle = <&phy1>;
+	phy-mode = "rgmii-id";
+	status = "okay";
+};
+
+&nfc {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcduino3b_nand_pins>, <&pcduino3b_nand_cs0_pin>,
+		    <&pcduino3b_nand_rb0_pin>;
+	status = "okay";
+
+	nand@0 {
+		reg = <0>;
+		allwinner,rb = <0>;
+		nand-ecc-mode = "hw";
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "spl-primary";
+				reg = <0x00000000 0x00400000>;
+			};
+
+			partition@400000 {
+				label = "spl-backup";
+				reg = <0x00400000 0x00400000>;
+			};
+
+			partition@800000 {
+				label = "uboot";
+				reg = <0x00800000 0x01800000>;
+			};
+
+			partition@2000000 {
+				label = "bootfit";
+				reg = <0x02000000 0x06000000>;
+			};
+
+			partition@8000000 {
+				label = "rootfs";
+				reg = <0x08000000 0xf8000000>;
+			};
+		};
+	};
+};
+
+&pio {
+	pcduino3b_nand_pins: nand-pins {
+		pins = "PC0", "PC1", "PC2", "PC5", "PC8", "PC9",
+		       "PC10", "PC11", "PC12", "PC13", "PC14",
+		       "PC15", "PC16";
+		function = "nand0";
+	};
+
+	pcduino3b_nand_cs0_pin: nand-cs0-pin {
+		pins = "PC4";
+		function = "nand0";
+	};
+
+	pcduino3b_nand_rb0_pin: nand-rb0-pin {
+		pins = "PC6";
+		function = "nand0";
+	};
+};
diff --git a/drivers/mtd/nand/raw/nand_ids.c b/drivers/mtd/nand/raw/nand_ids.c
index 4f46378..809ccf7 100644
--- a/drivers/mtd/nand/raw/nand_ids.c
+++ b/drivers/mtd/nand/raw/nand_ids.c
@@ -57,6 +57,10 @@ struct nand_flash_dev nand_flash_ids[] = {
 		{ .id = {0xad, 0xd7, 0x94, 0xda, 0x74, 0xc3} },
 		  SZ_8K, SZ_4K, SZ_2M, NAND_NEED_SCRAMBLING, 6, 640,
 		  NAND_ECC_INFO(40, SZ_1K), 0 },
+	{"H27UBG8T2CTR-BC 32G 3.3V 8-bit",
+		{ .id = {0xad, 0xd7, 0x94, 0x91, 0x60, 0x44} },
+		  SZ_8K, SZ_4K, SZ_2M, NAND_NEED_SCRAMBLING, 6, 640,
+		  NAND_ECC_INFO(40, SZ_1K), 0 },
 	{"H27UCG8T2ATR-BC 64G 3.3V 8-bit",
 		{ .id = {0xad, 0xde, 0x94, 0xda, 0x74, 0xc4} },
 		  SZ_8K, SZ_8K, SZ_2M, NAND_NEED_SCRAMBLING, 6, 640,
diff --git a/drivers/mtd/nand/raw/sunxi_nand_spl.c b/drivers/mtd/nand/raw/sunxi_nand_spl.c
index cf351de..06608d8 100644
--- a/drivers/mtd/nand/raw/sunxi_nand_spl.c
+++ b/drivers/mtd/nand/raw/sunxi_nand_spl.c
@@ -427,7 +427,7 @@ static int nand_maximize_user_data(struct nfc_config *conf, uint32_t oobsize,
 
 static int nand_max_ecc_strength(struct nfc_config *conf)
 {
-	int max_oobsize, max_ecc_bytes;
+	int max_oobsize;
 	int nsectors = conf->page_size / conf->ecc_size;
 	unsigned int total_user_data_sz = 0;
 	int ecc_idx, i;
@@ -453,8 +453,6 @@ static int nand_max_ecc_strength(struct nfc_config *conf)
 		return -EINVAL;
 	}
 
-	max_ecc_bytes = max_oobsize / nsectors;
-
 	/*
 	 * nand_min_user_data_sz() will return the total_user_data_sz in case
 	 * of a fixed user data length, or the minimal usable user data size
@@ -464,7 +462,8 @@ static int nand_max_ecc_strength(struct nfc_config *conf)
 	total_user_data_sz = nand_min_user_data_sz(conf, nsectors);
 
 	for (ecc_idx = 0; ecc_idx < ARRAY_SIZE(ecc_bytes); ecc_idx++) {
-		if (ecc_bytes[ecc_idx] + total_user_data_sz > max_ecc_bytes)
+		if (ecc_bytes[ecc_idx] * nsectors + total_user_data_sz >
+		    max_oobsize)
 			break;
 	}
 
