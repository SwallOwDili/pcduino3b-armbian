# pcDuino3B H27UBG8T2C NAND layout, version 2.
#
# The first three regions follow U-Boot's upstream sunxi NAND layout:
# SPL at 0, its backup at 4 MiB and U-Boot proper at 8 MiB.  A fixed raw
# boot-FIT region follows at 32 MiB so U-Boot never has to interpret an
# SLC-emulated UBI.  Linux exposes the remaining physical MLC through its
# paired-page-safe SLC emulation, which intentionally halves usable capacity.
PCDUINO3B_NAND_LAYOUT_VERSION=2
PCDUINO3B_NAND_ID=add794916044
PCDUINO3B_NAND_TOTAL_BYTES=4294967296
PCDUINO3B_NAND_ERASE_BYTES=2097152
PCDUINO3B_NAND_PAGE_BYTES=8192
PCDUINO3B_NAND_OOB_BYTES=640
PCDUINO3B_NAND_ECC_STRENGTH=40
PCDUINO3B_NAND_ECC_STEP_BYTES=1024
# Full data+OOB baseline captured and independently verified before writes.
PCDUINO3B_NAND_BASELINE_BACKUP_BYTES=4630511616
PCDUINO3B_NAND_BASELINE_BACKUP_SHA256=42e946fff07ebbc0f1a3c4e84c14e99fd57566624b42042edc826c03efeab1d3
PCDUINO3B_NAND_SPL_PRIMARY_OFFSET=0
PCDUINO3B_NAND_SPL_BACKUP_OFFSET=4194304
PCDUINO3B_NAND_SPL_REGION_BYTES=4194304
PCDUINO3B_NAND_UBOOT_OFFSET=8388608
PCDUINO3B_NAND_UBOOT_MAX_BYTES=786432
PCDUINO3B_NAND_UBOOT_REGION_BYTES=25165824
PCDUINO3B_NAND_BOOTFIT_OFFSET=33554432
PCDUINO3B_NAND_BOOTFIT_REGION_BYTES=100663296
PCDUINO3B_NAND_BOOTFIT_READ_BYTES=67108864
PCDUINO3B_NAND_BOOTFIT_MAX_BYTES=67108864
PCDUINO3B_NAND_ROOTFS_OFFSET=134217728
PCDUINO3B_NAND_ROOTFS_PHYSICAL_BYTES=4160749568
PCDUINO3B_NAND_ROOTFS_PHYSICAL_PEB_COUNT=1984
PCDUINO3B_NAND_ROOTFS_LOGICAL_BYTES=2080374784
PCDUINO3B_NAND_ROOTFS_PEB_BYTES=1048576
PCDUINO3B_NAND_ROOTFS_PEB_COUNT=1984
PCDUINO3B_NAND_ROOTFS_VID_OFFSET=8192
PCDUINO3B_NAND_ROOTFS_DATA_OFFSET=16384
PCDUINO3B_NAND_ROOTFS_LEB_BYTES=1032192
