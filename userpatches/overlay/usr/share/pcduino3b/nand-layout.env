# pcDuino3B H27UBG8T2C NAND layout, version 1.
#
# The first three regions follow U-Boot's upstream sunxi NAND layout:
# SPL at 0, its backup at 4 MiB and U-Boot proper at 8 MiB.  The remainder
# before 32 MiB is deliberately reserved so the UBI volume starts on a clean,
# eraseblock-aligned boundary after the legacy boot data observed on hardware.
PCDUINO3B_NAND_LAYOUT_VERSION=1
PCDUINO3B_NAND_ID=add794916044
PCDUINO3B_NAND_TOTAL_BYTES=4294967296
PCDUINO3B_NAND_ERASE_BYTES=2097152
PCDUINO3B_NAND_PAGE_BYTES=8192
PCDUINO3B_NAND_OOB_BYTES=640
PCDUINO3B_NAND_ECC_STRENGTH=40
PCDUINO3B_NAND_ECC_STEP_BYTES=1024
# Full data+OOB baseline captured and independently verified before writes.
PCDUINO3B_NAND_BASELINE_BACKUP_BYTES=4630511616
PCDUINO3B_NAND_BASELINE_BACKUP_SHA256=42e946fff07ebbc0f1a3c4e84c14e99fd57566624b42042edc826c03efeab1d3
PCDUINO3B_NAND_SPL_PRIMARY_OFFSET=0
PCDUINO3B_NAND_SPL_BACKUP_OFFSET=4194304
PCDUINO3B_NAND_SPL_REGION_BYTES=4194304
PCDUINO3B_NAND_UBOOT_OFFSET=8388608
PCDUINO3B_NAND_UBOOT_MAX_BYTES=786432
PCDUINO3B_NAND_UBOOT_REGION_BYTES=25165824
PCDUINO3B_NAND_UBI_OFFSET=33554432
PCDUINO3B_NAND_UBI_BYTES=4261412864
PCDUINO3B_NAND_UBI_PEB_COUNT=2032
PCDUINO3B_NAND_UBI_VID_OFFSET=8192
PCDUINO3B_NAND_UBI_DATA_OFFSET=16384
PCDUINO3B_NAND_UBI_LEB_BYTES=2080768
